{
  "name": "hyperlogger",
  "version": "1.0.0",
  "description": "Small, hardened logger for holepunch modules",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/**/*.js"
  ],
  "exports": {
    "./package": "./package.json",
    ".": "./index.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:node && npm run test:bare",
    "test:node": "brittle-node test/all.js",
    "test:bare": "brittle-bare test/all.js",
    "test:generate": "brittle -r test/all.js test/*.js"
  },
  "devDependencies": {
    "bare-path": "^3.1.3",
    "brittle": "^4.5.0",
    "lunte": "^1.3.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "bare-format": "^1.0.3",
    "bare-fs": "^4.8.6",
    "bare-hrtime": "^2.1.2",
    "bare-system-logger": "^1.0.7",
    "streamx": "^2.28.1"
  },
  "imports": {
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "#hrtime": {
      "bare": "bare-hrtime",
      "default": "./lib/hrtime.node.js"
    },
    "#system-logger": {
      "bare": "bare-system-logger",
      "default": "./lib/system-logger.node.js"
    },
    "#format": {
      "bare": "bare-format",
      "default": "./lib/format.node.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hyperlogger"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hyperlogger/issues"
  },
  "homepage": "https://github.com/holepunchto/hyperlogger"
}
